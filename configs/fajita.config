# HakiOS fragment: the OnePlus 6T (fajita) -- what is true of this device and of no other.
# Every phone driver is left out until it has been made to work here; the arguments only those drivers read go too.
CONFIG_DEVICE="fajita"
# the boot line is nearly full (597 of 607): the arguments only the kernel reads, and soc.args, are kept inside the kernel
# (tools/hakios-config.py builtin); the boot line carries the loader's and user space's. The run scripts check the kernel's
# hash before they leave them out (scripts/lib-args.sh); a kernel built without this still gets the whole line
CONFIG_ARGS_BUILTIN=y
# CONFIG_HAKIOS_ADSP is not set
# the audio DSP (B1, 11-13): the SDM845 ADSP started and linked up to QRTR's list of its services, drivers/audio/hakios.adsp845.c.
# It does nothing without adsp8=N (or CONFIG_ADSP8=N here: the boot line is nearly full, so a test round sets it in a fragment).
# Built in, not run: no register is touched, no TrustZone, RPMh or AOP message sent while ADSP8 is not set
CONFIG_HAKIOS_ADSP845=y
# the speaker by default (S8, 11-13: the user heard the keyboard's clicks and YouTube, r101): the DSP up and kept, steps 1-17 --
# the TFA9894 by hand on gpio89/90, then Darwin's /dev/hakios-audio to it until the run ends, at Darwin's volume less 12 dB,
# a limiter holding the peaks at -20 dBFS, the amplifier on only while there is sound and off for good after a fault
CONFIG_ADSP8=217
# The Beta's defaults, so that a run needs no argument on its line: LTE data (ipa8=11: the IPA, and the modem's data switch and
# data SIM set in its RAM), Bluetooth (bt=4: the image is BT=1's), the keychain (aks_keys=1: an image with RC=rc.launchd.aks
# stops at once without it -- run 106, "initproc failed to start")
CONFIG_IPA8=11
# /private/var kept across reboots (11-15): the partition darwin, 32 GiB cut off the end of userdata on LUN 0, takes the
# writes of userland/src/var_store.c and nothing else does (the loader and the kernel refuse every other partition, and a
# phone without darwin is written nothing). A save at the end of a run takes about 50 s on the 6T (189 MB, read back),
# so the way back to the loader waits up to three minutes for it (var_save_ms; the default 20 s ended r149 unsaved).
CONFIG_UFS_WRITE=y
CONFIG_VAR_STORE=y
CONFIG_VAR_SAVE_MS=180000
# Beta 0.5: /private/var is an HFS Plus volume in darwin from 12 GiB on (past var_store's two slots at 8-12 GiB, which
# are left as they are), made by tools/mkdatavol.py and install.sh; at its first mount init moves the newest slot into
# it once (userland/src/init.c), and from then on nothing is saved to the slots. Without the volume (not made yet, or
# ufs_write=0 as beta/run.sh runs) /private/var is the memory filesystem and var_store as before.
CONFIG_UFS_DATA_FIRST=3145728
CONFIG_VAR_HFS=y
CONFIG_BT=4
CONFIG_AKS_KEYS=1
# CONFIG_HAKIOS_SPEAKER is not set
# CONFIG_HAKIOS_SOUND is not set
# CONFIG_HAKIOS_MIC is not set
# CONFIG_HAKIOS_BT is not set
# Bluetooth (11-13, compiled only): the WCN3990's Bluetooth half on UART6 and iOS's bluetoothd on it
# (drivers/bluetooth/hakios.bt3990.c); does nothing without bt=N
CONFIG_HAKIOS_BT3990=y
# IOHIDResource for bluetoothd's keyboards and mice, and /dev/hakios-hid for backboardd (11-13, run 91)
CONFIG_HAKIOS_HIDRESOURCE=y
# CONFIG_HAKIOS_CAMERA is not set
# CONFIG_HAKIOS_TORCH is not set
# the flashlight (11-13): the PMI8998's flash LED module, TORCH's copy (drivers/camera/hakios.torch8998.c); torch=1 reads only
CONFIG_HAKIOS_TORCH8998=y
# ... for Darwin by default (11-13, the user's decision: lit from Control Center, 100 mA at most, 30 s at a time)
CONFIG_TORCH=3
# CONFIG_HAKIOS_ADRENO is not set
# the GPU (port step G1/G2): the Adreno 630's own copy of the steps, drivers/gpu/hakios.a630.c; does nothing without adreno=N
CONFIG_HAKIOS_A630=y
CONFIG_HAKIOS_GPUSERVICE=y
# CONFIG_HAKIOS_HAPTIC is not set
# the vibration motor (11-13): the PMI8998's haptics module, HAPTIC's copy (drivers/haptic/hakios.haptic8998.c); haptic=1 reads only
CONFIG_HAKIOS_HAPTIC8998=y
# ... for Darwin by default (11-13: the motor follows Darwin's Actuator; softer than OnePlus's, haptic_strength)
CONFIG_HAPTIC=5
# CONFIG_HAKIOS_GOODIX is not set
# the touch screen (step 2): a Synaptics controller on I2C (drivers/input/hakios.rmi4.c), not the reference phone's Goodix
CONFIG_HAKIOS_RMI4=y
CONFIG_RMI4=1
# the modem (Wi-Fi W1, 11-11): its own copy of the steps, drivers/modem/hakios.mpss845.c; does nothing without modem_step=N.
# The Wi-Fi's firmware runs on it. Its file systems are read from the phone (modemst1/2, fsg, fsc) into memory: never written
CONFIG_HAKIOS_QMI=y
CONFIG_HAKIOS_CELL=y
# CONFIG_HAKIOS_MODEM is not set
CONFIG_HAKIOS_MPSS845=y
# the battery (A2, 11-11): the PMI8998's gauge read only, shown through the BATTERY driver's power source
CONFIG_HAKIOS_BATTERY=y
CONFIG_HAKIOS_FG8998=y
# charging under this kernel (11-13, the user's decision): USB's input limit and the fast charge to 1 A (fg8998.c)
CONFIG_FG_CHARGE=1
# the screen's brightness (11-11): DCS to the AMOLED panel, with dsibl=1
CONFIG_HAKIOS_DSIBL=y
CONFIG_DSIBL=1
# CONFIG_HAKIOS_PMIC is not set
# CONFIG_HAKIOS_BATTGUARD is not set
# the storage, read only (A1, 11-11): partitions read through the loader (ufs=2); nothing writes (no ufs_write)
CONFIG_HAKIOS_UFS=y
# CONFIG_HAKIOS_WIFI is not set
CONFIG_HAKIOS_WIFI10=y
CONFIG_HAKIOS_WIFILX=y
# Wi-Fi by default (W5, 11-13: joined from Settings, DHCP, Safari): the modem up to its link and kept (its file systems read
# early, never written), then ath10k on the WCN3990 as the system's station, with an address of its own (the firmware gives none)
CONFIG_MODEM_STEP=12
CONFIG_MODEM_KEEP=1
CONFIG_WIFI_STATION=1
CONFIG_WIFI_BA=1
# 40 and 80 MHz where the access point offers them (run 47: the hotspot at 5 GHz, 802.11ac at 80 MHz, 95 Mbit/s)
CONFIG_WIFI_WIDE=1
CONFIG_WIFI_MAC="02:6f:6e:65:36:54"
# CONFIG_TOUCHSCREEN is not set
# the GPU kept for the window server (11-11): gpu=1, CoreAnimation's frame clock from the display driver (ca_vbl)
CONFIG_GPU=y
CONFIG_CA_VBL=y
# the cores' speed by their load (cpufreq_gov=1, on cpufreq=1 of sdm845.config), not the top row for good
CONFIG_CPUFREQ_GOV=1
# CONFIG_ADSP is not set
# CONFIG_SOUND is not set
CONFIG_WIFI=y
# CONFIG_MODEM is not set
# CONFIG_MODEM_AGAIN is not set
# the GPU's firmware from the phone (fw-gpu/: a630_gmu.bin, a630_sqe.fw, the phone's signed a630_zap), so "device"
CONFIG_FIRMWARE="device"
# the power and volume keys (step 2): the PM8998's power-on block (power, volume down) and its GPIO6 (volume up), read only;
# where they are is in soc.args (buttons_pon=, buttons_volup=)
CONFIG_HAKIOS_BUTTONS=y
CONFIG_BUTTONS=1
